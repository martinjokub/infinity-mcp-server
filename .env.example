# Copy this file to .env and fill in your own values. Never commit .env.
# For local stdio-only use, you may set INFINITY_API_TOKEN in your shell instead.

INFINITY_API_VERSION=2026-04-20.morava
INFINITY_API_BASE_URL=https://app.startinfinity.com/api/v2

# Docker and cloud HTTP mode.
TRANSPORT=http
PORT=3000

# Required for HTTP mode. Generate with: npm run credentials:init
MCP_CREDENTIAL_STORE_KEY=replace-with-generated-master-key
MCP_USERS_FILE=/app/config/mcp-users.json
MCP_CREDENTIAL_STORE_FILE=/app/data/credentials.enc.json
