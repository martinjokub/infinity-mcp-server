{
  "name": "infinity-mcp-server",
  "version": "0.1.2",
  "description": "MCP server for StartInfinity API access by agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinjokub/infinity-mcp-server.git"
  },
  "keywords": [
    "infinity",
    "startinfinity",
    "mcp",
    "model-context-protocol",
    "agents"
  ],
  "bin": {
    "infinity-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "credentials:init": "node scripts/credentials.mjs init",
    "credentials:add-profile": "node scripts/credentials.mjs add-profile",
    "credentials:add-user": "node scripts/credentials.mjs add-user",
    "credentials:list": "node scripts/credentials.mjs list",
    "credentials:rotate-user-key": "node scripts/credentials.mjs rotate-user-key"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
